# Absolute origin for canonical, Open Graph, sitemap, and llms.txt links.
# Empty falls back to the Vercel production URL.
NEXT_PUBLIC_SITE_URL=

# GA4 measurement id. Empty means no analytics script and no consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional webhook for the inquiry form. Empty keeps the form on screen
# and shows the public phone and email. Do not point this at the live site.
INQUIRY_WEBHOOK_URL=
